# Server
PORT=8080
NODE_ENV=production

# DB
DATABASE_URL=postgres://user:pass@localhost:5432/unloop

# Encryption
# 32-byte base64 key for AES-256-GCM
FIELD_ENCRYPTION_KEY_B64=REPLACE_WITH_32_BYTE_BASE64

# Hashing (pepper for deterministic hashes)
HASH_PEPPER=REPLACE_WITH_STRONG_SECRET

# Auth (HS256)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# CORS (comma-separated)
CORS_ORIGINS=https://your-frontend.example
